# Formspree form ID for the contact form (https://formspree.io)
# Create a free form, copy the ID from the endpoint URL (https://formspree.io/f/XXXXXXXX),
# then create a local `.env` file with: VITE_FORMSPREE_ID=XXXXXXXX
# If left empty, the contact form falls back to opening the visitor's mail client (mailto).
VITE_FORMSPREE_ID=

# Canonical public site root. Include a trailing slash and any production subpath.
VITE_SITE_URL=https://abdulsalam.pro/
# Set true for staging or mirror builds; leave false for the primary website.
VITE_NOINDEX=false
